# ==============================================================================
# ProofBridge Environment Configuration Template
# Copy this file to '.env' and fill in your real credentials.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Higher Authority / Master Administrator Account (Configured in local .env only)
VITE_AUTHORITY_FULL_NAME=Your Full Name
VITE_AUTHORITY_EMAIL=authority@yourorganization.com
VITE_AUTHORITY_PASSWORD=YourStrongMasterPassword
VITE_AUTHORITY_BACKUP_PIN=Your6DigitMasterPIN
