# ==============================================================================
# ProofBridge Environment Configuration Template
# ==============================================================================

# --- CLIENT-SIDE VARIABLES (Exposed to browser via Vite) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_AUTHORITY_FULL_NAME=Your Full Name
VITE_AUTHORITY_EMAIL=authority@yourorganization.com

# --- SERVER-ONLY VARIABLES (Used by Vercel Serverless Function /api/authority) ---
# In Vercel, set these WITHOUT the 'VITE_' prefix so they stay 100% server-side!
AUTHORITY_FULL_NAME=Your Full Name
AUTHORITY_EMAIL=authority@yourorganization.com
AUTHORITY_PASSWORD=YourStrongMasterPassword
AUTHORITY_BACKUP_PIN=Your6DigitMasterPIN
